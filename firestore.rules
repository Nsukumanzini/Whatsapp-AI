rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin dashboard read/write access to leads
    match /leads/{leadId} {
      allow read, write: if true; // In production, restrict to: request.auth != null
    }

    // Chats and nested message history
    match /chats/{phoneNumber} {
      allow read, write: if true; // In production, restrict to: request.auth != null

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Processed messages deduplication table
    match /processed_messages/{messageId} {
      allow read, write: if true;
    }
  }
}
